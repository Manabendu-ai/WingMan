#!/usr/bin/env python3
"""WingMan prompt-triggered VLM perception node backed by a local Ollama model.

This node is advisory-only. It publishes structured observations and NEVER publishes
/cmd_vel, PX4 setpoints, or raw MAVLink commands.
"""
import base64
import json
import math
import threading
import time
import urllib.error
import urllib.request

import cv2
import numpy as np
import rclpy
from cv_bridge import CvBridge
from nav_msgs.msg import OccupancyGrid, Odometry
from rclpy.node import Node
from rclpy.qos import QoSProfile, ReliabilityPolicy, HistoryPolicy
from sensor_msgs.msg import Image
from std_msgs.msg import String


DEFAULT_MODEL = "gemma3:4b"
DEFAULT_CAMERA_TOPIC = (
    "/world/maze_exploration/model/x500_gps_denied_0/"
    "link/camera_link/sensor/IMX214/image"
)


class WingmanVLM(Node):
    def __init__(self):
        super().__init__("wingman_vlm")
        self.declare_parameter("model", DEFAULT_MODEL)
        self.declare_parameter("ollama_url", "http://127.0.0.1:11434/api/chat")
        self.declare_parameter("camera_topic", DEFAULT_CAMERA_TOPIC)
        self.declare_parameter("prompt_topic", "/wingman/vlm_prompt")
        self.declare_parameter("mission_topic", "/wingman/mission_json")
        self.declare_parameter("map_topic", "/map")
        self.declare_parameter("odom_topic", "/odom")
        self.declare_parameter("output_topic", "/wingman/vlm/observation")
        self.declare_parameter("max_image_width", 512)
        self.declare_parameter("jpeg_quality", 75)
        self.declare_parameter("frame_capture_period_sec", 0.5)
        self.declare_parameter("map_capture_period_sec", 1.0)
        self.declare_parameter("max_camera_age_sec", 3.0)
        self.declare_parameter("http_timeout_sec", 90.0)
        self.declare_parameter("num_predict", 160)

        p = lambda name: self.get_parameter(name).value
        self.model = str(p("model"))
        self.ollama_url = str(p("ollama_url"))
        self.camera_topic = str(p("camera_topic"))
        self.prompt_topic = str(p("prompt_topic"))
        self.mission_topic = str(p("mission_topic"))
        self.map_topic = str(p("map_topic"))
        self.odom_topic = str(p("odom_topic"))
        self.output_topic = str(p("output_topic"))
        self.max_image_width = max(160, int(p("max_image_width")))
        self.jpeg_quality = min(95, max(40, int(p("jpeg_quality"))))
        self.capture_period = max(0.1, float(p("frame_capture_period_sec")))
        self.map_capture_period = max(0.25, float(p("map_capture_period_sec")))
        self.max_camera_age = max(0.5, float(p("max_camera_age_sec")))
        self.http_timeout = max(5.0, float(p("http_timeout_sec")))
        self.num_predict = max(32, int(p("num_predict")))

        self.bridge = CvBridge()
        self.lock = threading.Lock()
        self.latest_image_b64 = None
        self.latest_image_received = 0.0
        self.latest_image_stamp = ""
        self.last_image_process = 0.0
        self.latest_map_image_b64 = None
        self.latest_map_received = 0.0
        self.last_map_process = 0.0
        self.latest_map_summary = {"available": False}
        self.latest_odom_summary = {"available": False}
        self.latest_mission_json = None
        self.inference_busy = False
        self.pending_prompt = None

        sensor_qos = QoSProfile(
            reliability=ReliabilityPolicy.BEST_EFFORT,
            history=HistoryPolicy.KEEP_LAST,
            depth=1,
        )
        self.image_sub = self.create_subscription(
            Image, self.camera_topic, self.on_image, sensor_qos
        )
        self.map_sub = self.create_subscription(
            OccupancyGrid, self.map_topic, self.on_map, 1
        )
        self.odom_sub = self.create_subscription(
            Odometry, self.odom_topic, self.on_odom, 10
        )
        self.mission_sub = self.create_subscription(
            String, self.mission_topic, self.on_mission_json, 10
        )
        self.prompt_sub = self.create_subscription(
            String, self.prompt_topic, self.on_prompt, 10
        )
        self.output_pub = self.create_publisher(String, self.output_topic, 10)

        self.get_logger().info("WingMan VLM node initialized (advisory-only)")
        self.get_logger().info(f"Camera input: {self.camera_topic}")
        self.get_logger().info(f"Mission JSON input: {self.mission_topic}")
        self.get_logger().info(f"Prompt input: {self.prompt_topic}")
        self.get_logger().info(f"JSON observations: {self.output_topic}")
        self.get_logger().info(f"Ollama model: {self.model}")

    def publish_json(self, obj):
        msg = String()
        msg.data = json.dumps(obj, ensure_ascii=False, separators=(",", ":"))
        self.output_pub.publish(msg)

    def on_image(self, msg):
        now = time.monotonic()
        # A prompt only needs a recent frame. Avoid compressing a 1080p camera at 30 Hz.
        if now - self.last_image_process < self.capture_period:
            return
        self.last_image_process = now
        try:
            frame = self.bridge.imgmsg_to_cv2(msg, desired_encoding="bgr8")
            h, w = frame.shape[:2]
            if w > self.max_image_width:
                new_h = max(1, int(h * self.max_image_width / float(w)))
                frame = cv2.resize(frame, (self.max_image_width, new_h), interpolation=cv2.INTER_AREA)
            ok, encoded = cv2.imencode(
                ".jpg", frame, [int(cv2.IMWRITE_JPEG_QUALITY), self.jpeg_quality]
            )
            if not ok:
                raise RuntimeError("OpenCV failed to encode camera image")
            stamp = f"{msg.header.stamp.sec}.{msg.header.stamp.nanosec:09d}"
            with self.lock:
                self.latest_image_b64 = base64.b64encode(encoded.tobytes()).decode("ascii")
                self.latest_image_received = now
                self.latest_image_stamp = stamp
        except Exception as exc:
            self.get_logger().warning(f"Could not process camera frame: {exc}", throttle_duration_sec=5.0)

    def on_map(self, msg):
        try:
            data = msg.data
            total = len(data)
            unknown = sum(1 for v in data if int(v) < 0)
            free = sum(1 for v in data if 0 <= int(v) <= 20)
            occupied = sum(1 for v in data if int(v) >= 65)
            intermediate = max(0, total - unknown - free - occupied)
            res = float(msg.info.resolution)
            summary = {
                "available": True,
                "frame_id": msg.header.frame_id,
                "width_cells": int(msg.info.width),
                "height_cells": int(msg.info.height),
                "resolution_m_per_cell": res,
                "extent_m": {
                    "x": round(int(msg.info.width) * res, 3),
                    "y": round(int(msg.info.height) * res, 3),
                },
                "origin_xy_m": {
                    "x": round(float(msg.info.origin.position.x), 3),
                    "y": round(float(msg.info.origin.position.y), 3),
                },
                "cell_counts": {
                    "total": total, "unknown": unknown, "free": free,
                    "occupied": occupied, "intermediate": intermediate,
                },
                "note": "Occupancy-grid summary only; cells are not sent as a camera image.",
            }
            now = time.monotonic()
            # Re-render the occupancy grid at a limited rate to keep CPU use low.
            map_image_b64 = None
            if now - self.last_map_process >= self.map_capture_period and msg.info.width > 0 and msg.info.height > 0:
                self.last_map_process = now
                grid = np.asarray(data, dtype=np.int16).reshape(int(msg.info.height), int(msg.info.width))
                pixels = np.full(grid.shape, 180, dtype=np.uint8)  # unknown = grey
                pixels[(grid >= 0) & (grid <= 20)] = 245          # free = white
                pixels[grid >= 65] = 15                            # occupied = black
                pixels[(grid > 20) & (grid < 65)] = 120            # uncertain = mid-grey
                # ROS map rows increase in +Y; flip for an image with +Y upward.
                pixels = cv2.flip(pixels, 0)
                map_bgr = cv2.cvtColor(pixels, cv2.COLOR_GRAY2BGR)
                ok, encoded_map = cv2.imencode(".png", map_bgr)
                if ok:
                    map_image_b64 = base64.b64encode(encoded_map.tobytes()).decode("ascii")
            with self.lock:
                self.latest_map_summary = summary
                if map_image_b64 is not None:
                    self.latest_map_image_b64 = map_image_b64
                    self.latest_map_received = now
        except Exception as exc:
            self.get_logger().warning(f"Could not summarize/render map: {exc}", throttle_duration_sec=5.0)

    def on_odom(self, msg):
        p = msg.pose.pose.position
        q = msg.pose.pose.orientation
        sin_yaw = 2.0 * (q.w * q.z + q.x * q.y)
        cos_yaw = 1.0 - 2.0 * (q.y * q.y + q.z * q.z)
        yaw = math.atan2(sin_yaw, cos_yaw)
        summary = {
            "available": True,
            "frame_id": msg.header.frame_id,
            "child_frame_id": msg.child_frame_id,
            "position_m": {"x": round(p.x, 3), "y": round(p.y, 3), "z": round(p.z, 3)},
            "yaw_rad": round(yaw, 3),
            "linear_velocity_mps": {
                "x": round(msg.twist.twist.linear.x, 3),
                "y": round(msg.twist.twist.linear.y, 3),
                "z": round(msg.twist.twist.linear.z, 3),
            },
            "note": "Estimated odometry; validity depends on the upstream localization system.",
        }
        with self.lock:
            self.latest_odom_summary = summary

    def on_mission_json(self, msg):
        raw = msg.data.strip()
        try:
            parsed = json.loads(raw)
            if not isinstance(parsed, dict):
                raise ValueError("mission JSON must be a JSON object")
            # Bound context size so a large external prompt cannot exhaust RAM/context.
            compact = json.dumps(parsed, ensure_ascii=False, separators=(",", ":"))[:4000]
            stored = {"valid": True, "json": compact}
            self.get_logger().info("Received mission JSON on /wingman/mission_json")
        except Exception as exc:
            stored = {"valid": False, "error": str(exc), "raw_prefix": raw[:500]}
            self.get_logger().warning(f"Mission JSON was not a valid JSON object: {exc}")
        with self.lock:
            self.latest_mission_json = stored

    def on_prompt(self, msg):
        prompt = msg.data.strip()
        if not prompt:
            self.publish_json({"ok": False, "error": "Prompt is empty", "actuation_authorized": False})
            return
        with self.lock:
            if self.inference_busy:
                busy = True
            else:
                self.inference_busy = True
                busy = False
                self.pending_prompt = prompt
                image_b64 = self.latest_image_b64
                image_age = time.monotonic() - self.latest_image_received if image_b64 else None
                image_stamp = self.latest_image_stamp
                map_summary = dict(self.latest_map_summary)
                map_image_b64 = self.latest_map_image_b64
                map_age = time.monotonic() - self.latest_map_received if map_image_b64 else None
                odom_summary = dict(self.latest_odom_summary)
                mission = self.latest_mission_json
        if busy:
            self.publish_json({"ok": False, "error": "VLM is already processing a prompt; wait for its result", "actuation_authorized": False})
            return
        if image_b64 is None or image_age is None or image_age > self.max_camera_age:
            with self.lock:
                self.inference_busy = False
            self.publish_json({
                "ok": False,
                "error": "No recent camera frame. Check Gazebo camera bridge and camera_topic.",
                "camera_topic": self.camera_topic,
                "camera_age_sec": image_age,
                "actuation_authorized": False,
            })
            return
        worker = threading.Thread(
            target=self.run_inference,
            args=(prompt, image_b64, image_age, image_stamp, map_summary, map_image_b64, map_age, odom_summary, mission),
            daemon=True,
        )
        worker.start()

    def run_inference(self, prompt, image_b64, image_age, image_stamp, map_summary, map_image_b64, map_age, odom_summary, mission):
        system_instructions = (
            "You are WingMan's VLM mission advisor for a GPS-denied maze drone. Analyze the latest front-camera frame, "
            "occupancy-grid map image/summary, odometry summary and mission. Distinguish visual evidence from inference; "
            "never invent metric distances, coordinates, sensor values or person detections. Return exactly one JSON object "
            "with keys: scene (string), person_detected (true/false/unknown), visible_openings (array), visual_obstacles (array), "
            "visual_summary (string), recommended_next_step (string), confidence (0 to 1 or null), uncertainties (array), "
            "mission_action (one of explore, return_to_entrance, hold), preferred_direction (one of left, forward, right, unknown). "
            "Default mission_action to explore when the scene is navigable and there is no clear reason to stop. Use hold only "
            "when the current view is too uncertain to choose a safe exploration continuation or a clear immediate hazard requires "
            "operator review. Use return_to_entrance only when the mission should clearly end; the planner will independently "
            "return when no reachable frontiers remain. Select preferred_direction only if a branch/opening is clearly visible; "
            "otherwise use unknown. Do not issue executable code, raw MAVLink, PX4 setpoints, velocity commands, or motor commands. "
            "These are high-level advisory decisions, not direct actuation."
        )
        context = {
            "operator_prompt": prompt,
            "mission_json": mission,
            "map_summary": map_summary,
            "estimated_odometry": odom_summary,
            "camera_frame": {"topic": self.camera_topic, "stamp": image_stamp, "age_sec_at_request": round(image_age, 3)},
            "occupancy_map_image": {"included_as_second_image": bool(map_image_b64), "age_sec": round(map_age, 3) if map_age is not None else None, "display": "+Y upward, free=white, occupied=black, unknown=grey"},
        }
        content = system_instructions + "\n\nCurrent context JSON:\n" + json.dumps(context, ensure_ascii=False)
        body = {
            "model": self.model,
            "messages": [{"role": "user", "content": content, "images": [image_b64] + ([map_image_b64] if map_image_b64 and map_age is not None and map_age <= 5.0 else [])}],
            "stream": False,
            "format": "json",
            "keep_alive": "5m",
            "options": {"temperature": 0.1, "num_predict": self.num_predict},
        }
        result = None
        try:
            request = urllib.request.Request(
                self.ollama_url,
                data=json.dumps(body).encode("utf-8"),
                headers={"Content-Type": "application/json"},
                method="POST",
            )
            with urllib.request.urlopen(request, timeout=self.http_timeout) as response:
                api_data = json.loads(response.read().decode("utf-8"))
            content_text = api_data.get("message", {}).get("content", "")
            if not content_text:
                raise RuntimeError("Ollama returned an empty message")
            try:
                parsed = json.loads(content_text)
            except json.JSONDecodeError:
                parsed = {"visual_summary": content_text, "uncertainties": ["Model response was not valid JSON"]}
            if not isinstance(parsed, dict):
                parsed = {"model_output": parsed}
            parsed.update({
                "ok": True,
                "model": self.model,
                "prompt": prompt,
                "camera_topic": self.camera_topic,
                "camera_stamp": image_stamp,
                "camera_age_sec": round(image_age, 3),
                "map_summary": map_summary,
                "map_image_included": bool(map_image_b64 and map_age is not None and map_age <= 5.0),
                "map_image_age_sec": round(map_age, 3) if map_age is not None else None,
                "estimated_odometry": odom_summary,
                "mission_json_received": bool(mission and mission.get("valid")),
                "actuation_authorized": False,
                "safety_note": "Perception only. No flight command was generated or sent.",
            })
            result = parsed
            self.get_logger().info("VLM inference completed; see /wingman/vlm/observation for JSON")
        except urllib.error.HTTPError as exc:
            detail = exc.read().decode("utf-8", errors="replace")[:1000]
            result = {"ok": False, "error": f"Ollama HTTP {exc.code}: {detail}", "actuation_authorized": False}
            self.get_logger().error(result["error"])
        except Exception as exc:
            result = {"ok": False, "error": str(exc), "ollama_url": self.ollama_url, "model": self.model, "actuation_authorized": False}
            self.get_logger().error(f"VLM inference failed: {exc}")
        finally:
            if result is not None:
                self.publish_json(result)
            with self.lock:
                self.inference_busy = False
                self.pending_prompt = None


def main(args=None):
    rclpy.init(args=args)
    node = WingmanVLM()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == "__main__":
    main()
