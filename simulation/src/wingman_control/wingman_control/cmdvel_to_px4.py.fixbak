#!/usr/bin/env python3
import rclpy
from rclpy.node import Node
from geometry_msgs.msg import Twist
from px4_msgs.msg import OffboardControlMode, TrajectorySetpoint, VehicleCommand

class CmdVelToPx4(Node):
    def __init__(self):
        super().__init__('cmdvel_to_px4')

        # Subscribe to Nav2 velocity smoother output
        self.create_subscription(Twist, '/cmd_vel', self.cmd_vel_callback, 10)

        self.offboard_pub = self.create_publisher(OffboardControlMode, '/fmu/in/offboard_control_mode', 10)
        self.trajectory_pub = self.create_publisher(TrajectorySetpoint, '/fmu/in/trajectory_setpoint', 10)

        # 20Hz Heartbeat timer required by PX4 Offboard mode
        self.timer = self.create_timer(0.05, self.timer_callback)

        self.target_vx = 0.0
        self.target_vy = 0.0
        self.target_wz = 0.0

        # Hover altitude setpoint (meters)
        self.hover_z = -1.0  # PX4 NED (Negative = Up)

        self.get_logger().info('CmdVel to PX4 Offboard node active with smooth velocity clamping.')

    def cmd_vel_callback(self, msg: Twist):
        # Clamp velocity to max 0.3 m/s to prevent aggressive tilt in tight corridors
        self.target_vx = max(min(float(msg.linear.x), 0.3), -0.3)
        self.target_vy = max(min(float(msg.linear.y), 0.3), -0.3)
        self.target_wz = max(min(float(msg.angular.z), 0.5), -0.5)

    def timer_callback(self):
        now_us = int(self.get_clock().now().nanoseconds / 1000)

        # 1. Publish Offboard Control Mode (Velocity + Position mode)
        offboard_msg = OffboardControlMode()
        offboard_msg.timestamp = now_us
        offboard_msg.position = True
        offboard_msg.velocity = True
        offboard_msg.acceleration = False
        offboard_msg.attitude = False
        offboard_msg.body_rate = False
        self.offboard_pub.publish(offboard_msg)

        # 2. Publish Trajectory Setpoint (Maintain hover height, stream smooth XY velocities)
        setpoint = TrajectorySetpoint()
        setpoint.timestamp = now_us
        setpoint.position = [float('nan'), float('nan'), self.hover_z]  # Hold Z at 1.0m altitude
        setpoint.velocity = [self.target_vx, self.target_vy, 0.0]        # Smooth XY velocities (NED)
        setpoint.yawspeed = self.target_wz
        self.trajectory_pub.publish(setpoint)

def main(args=None):
    rclpy.init(args=args)
    node = CmdVelToPx4()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()

if __name__ == '__main__':
    main()