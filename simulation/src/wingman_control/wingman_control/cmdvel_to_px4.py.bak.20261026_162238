#!/usr/bin/env python3
"""Nav2 /cmd_vel (base_link, FLU) -> PX4 offboard velocity setpoints, with altitude hold.
Services: /wingman/takeoff and /wingman/land (std_srvs/Trigger).
Safety: zero velocity if /cmd_vel is older than 0.5 s or /odom older than 1.0 s."""
import math
import rclpy
from rclpy.node import Node
from rclpy.qos import QoSProfile, ReliabilityPolicy, DurabilityPolicy, HistoryPolicy
from geometry_msgs.msg import Twist
from nav_msgs.msg import Odometry
from std_srvs.srv import Trigger
from px4_msgs.msg import OffboardControlMode, TrajectorySetpoint, VehicleCommand, VehicleLocalPosition
 
NAN = float('nan')
 
 
class CmdVelToPx4(Node):
    def __init__(self):
        super().__init__('cmdvel_to_px4')
        self.declare_parameter('takeoff_alt', 1.0)
        self.declare_parameter('climb_speed', 0.5)
        self.declare_parameter('local_position_topic', '/fmu/out/vehicle_local_position')
        self.alt = float(self.get_parameter('takeoff_alt').value)
        self.climb = float(self.get_parameter('climb_speed').value)
 
        qos = QoSProfile(reliability=ReliabilityPolicy.BEST_EFFORT,
                         durability=DurabilityPolicy.TRANSIENT_LOCAL,
                         history=HistoryPolicy.KEEP_LAST, depth=1)
        self.p_mode = self.create_publisher(OffboardControlMode, '/fmu/in/offboard_control_mode', qos)
        self.p_sp = self.create_publisher(TrajectorySetpoint, '/fmu/in/trajectory_setpoint', qos)
        self.p_cmd = self.create_publisher(VehicleCommand, '/fmu/in/vehicle_command', qos)
 
        qos_sub = QoSProfile(reliability=ReliabilityPolicy.BEST_EFFORT,
                             durability=DurabilityPolicy.VOLATILE,
                             history=HistoryPolicy.KEEP_LAST, depth=5)
        self.create_subscription(Twist, '/cmd_vel', self.on_cmd, 10)
        self.create_subscription(Odometry, '/odom', self.on_odom, 10)
        self.create_subscription(VehicleLocalPosition,
                                 self.get_parameter('local_position_topic').value,
                                 self.on_lpos, qos_sub)
        self.create_service(Trigger, '/wingman/takeoff', self.srv_takeoff)
        self.create_service(Trigger, '/wingman/land', self.srv_land)
 
        self.state = 'idle'          # idle -> arming -> climbing -> flying -> landing
        self.state_t = self.now_s()
        self.tick = 0
        self.cmd = Twist(); self.cmd_t = -1e9
        self.yaw = 0.0; self.odom_t = -1e9
        self.z_ned = None
        self.create_timer(0.05, self.loop)   # 20 Hz (offboard needs > 2 Hz)
        self.get_logger().info('cmdvel_to_px4 ready. Call /wingman/takeoff to start.')
 
    def now_s(self):
        return self.get_clock().now().nanoseconds * 1e-9
 
    def us(self):
        return int(self.get_clock().now().nanoseconds / 1000)
 
    def set_state(self, s):
        self.state = s; self.state_t = self.now_s(); self.get_logger().info(f'state -> {s}')
 
    def send_cmd(self, command, p1=0.0, p2=0.0):
        m = VehicleCommand()
        m.timestamp = self.us(); m.command = command
        m.param1 = float(p1); m.param2 = float(p2)
        m.target_system = 1; m.target_component = 1
        m.source_system = 1; m.source_component = 1
        m.from_external = True
        self.p_cmd.publish(m)
 
    def on_cmd(self, m):
        self.cmd = m; self.cmd_t = self.now_s()
 
    def on_odom(self, m):
        q = m.pose.pose.orientation
        self.yaw = math.atan2(2 * (q.w * q.z + q.x * q.y), 1 - 2 * (q.y * q.y + q.z * q.z))
        self.odom_t = self.now_s()
 
    def on_lpos(self, m):
        self.z_ned = float(m.z)
 
    def srv_takeoff(self, req, res):
        if self.now_s() - self.odom_t > 1.0:
            res.success = False; res.message = 'No fresh /odom - refusing to take off'; return res
        if self.state in ('idle', 'landing'):
            self.tick = 0; self.set_state('arming')
        res.success = True; res.message = 'takeoff started'; return res
 
    def srv_land(self, req, res):
        self.send_cmd(VehicleCommand.VEHICLE_CMD_NAV_LAND)
        self.set_state('landing'); res.success = True; res.message = 'landing'; return res
 
    def publish_setpoint(self, pos, vel, yawspeed):
        mode = OffboardControlMode()
        mode.timestamp = self.us()
        mode.position = True; mode.velocity = True
        mode.acceleration = False; mode.attitude = False; mode.body_rate = False
        self.p_mode.publish(mode)
        sp = TrajectorySetpoint()
        sp.timestamp = self.us()
        sp.position = [float(v) for v in pos]
        sp.velocity = [float(v) for v in vel]
        sp.yaw = NAN; sp.yawspeed = float(yawspeed)
        self.p_sp.publish(sp)
 
    def loop(self):
        if self.state in ('idle', 'landing'):
            return
        now = self.now_s()
        self.tick += 1
        hold_z = -self.alt
 
        if self.state == 'arming':
            self.publish_setpoint([NAN, NAN, NAN], [0, 0, 0], 0.0)
            if self.tick == 20:   # > 1 s of setpoints before switching mode
                self.send_cmd(VehicleCommand.VEHICLE_CMD_DO_SET_MODE, 1.0, 6.0)
                self.send_cmd(VehicleCommand.VEHICLE_CMD_COMPONENT_ARM_DISARM, 1.0)
            if self.tick > 30:
                self.set_state('climbing')
            return
 
        if self.state == 'climbing':
            reached = (self.z_ned is not None and self.z_ned <= hold_z + 0.1) or (now - self.state_t > 12.0)
            if reached:
                self.set_state('flying')
            self.publish_setpoint([NAN, NAN, NAN], [0, 0, -self.climb], 0.0)
            return
 
        fresh = ((now - self.cmd_t) < 0.5) and ((now - self.odom_t) < 1.0)
        vx = self.cmd.linear.x if fresh else 0.0
        vy = self.cmd.linear.y if fresh else 0.0
        wz = self.cmd.angular.z if fresh else 0.0
        c, s = math.cos(self.yaw), math.sin(self.yaw)
        vo_x = c * vx - s * vy
        vo_y = s * vx + c * vy
        # odom (x, y) -> NED (east, north); NED yaw rate has the opposite sign
        self.publish_setpoint([NAN, NAN, hold_z], [vo_y, vo_x, NAN], -wz)
 
 
def main():
    rclpy.init()
    rclpy.spin(CmdVelToPx4())
 
 
if __name__ == '__main__':
    main()
