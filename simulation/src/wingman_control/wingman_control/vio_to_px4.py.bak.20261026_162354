#!/usr/bin/env python3
"""Guarded bridge: RTAB-Map /odom + /odom_info -> PX4 vehicle_visual_odometry.

This is a forwarding bridge, NOT a VIO estimator. It refuses to forward stale,
lost, malformed, or implausibly weak ICP odometry.
"""
import math
import numpy as np
import rclpy
from rclpy.node import Node
from rclpy.qos import QoSProfile, ReliabilityPolicy, DurabilityPolicy, HistoryPolicy
from nav_msgs.msg import Odometry
from rtabmap_msgs.msg import OdomInfo
from px4_msgs.msg import VehicleOdometry

R_NED_ENU = np.array([[0., 1., 0.], [1., 0., 0.], [0., 0., -1.]])
R_FLU_FRD = np.diag([1., -1., -1.])


def quat_to_R(x, y, z, w):
    return np.array([
        [1 - 2*(y*y + z*z), 2*(x*y - z*w), 2*(x*z + y*w)],
        [2*(x*y + z*w), 1 - 2*(x*x + z*z), 2*(y*z - x*w)],
        [2*(x*z - y*w), 2*(y*z + x*w), 1 - 2*(x*x + y*y)]])


def R_to_quat_wxyz(R):
    t = float(np.trace(R))
    if t > 0:
        s = math.sqrt(t + 1.0) * 2
        w, x, y, z = 0.25*s, (R[2,1]-R[1,2])/s, (R[0,2]-R[2,0])/s, (R[1,0]-R[0,1])/s
    elif R[0,0] > R[1,1] and R[0,0] > R[2,2]:
        s = math.sqrt(1.0 + R[0,0] - R[1,1] - R[2,2]) * 2
        w, x, y, z = (R[2,1]-R[1,2])/s, 0.25*s, (R[0,1]+R[1,0])/s, (R[0,2]+R[2,0])/s
    elif R[1,1] > R[2,2]:
        s = math.sqrt(1.0 + R[1,1] - R[0,0] - R[2,2]) * 2
        w, x, y, z = (R[0,2]-R[2,0])/s, (R[0,1]+R[1,0])/s, 0.25*s, (R[1,2]+R[2,1])/s
    else:
        s = math.sqrt(1.0 + R[2,2] - R[0,0] - R[1,1]) * 2
        w, x, y, z = (R[1,0]-R[0,1])/s, (R[0,2]+R[2,0])/s, (R[1,2]+R[2,1])/s, 0.25*s
    q = np.array([w, x, y, z], dtype=float)
    n = np.linalg.norm(q)
    if not np.isfinite(n) or n < 1e-6:
        raise ValueError('invalid quaternion')
    return q / n


class VioToPx4(Node):
    def __init__(self):
        super().__init__('vio_to_px4')
        self.declare_parameter('max_odom_age_sec', 0.25)
        self.declare_parameter('min_icp_correspondences', 25)
        self.declare_parameter('min_icp_inlier_ratio', 0.20)
        qos_pub = QoSProfile(reliability=ReliabilityPolicy.BEST_EFFORT,
                             durability=DurabilityPolicy.TRANSIENT_LOCAL,
                             history=HistoryPolicy.KEEP_LAST, depth=1)
        self.pub = self.create_publisher(VehicleOdometry, '/fmu/in/vehicle_visual_odometry', qos_pub)
        self.info = None
        self.info_received_at = None
        self.create_subscription(OdomInfo, '/odom_info', self.on_info, 10)
        self.create_subscription(Odometry, '/odom', self.on_odom, 10)
        self.get_logger().info('Guarded odom bridge ready; waiting for healthy /odom_info')

    def now_s(self):
        return self.get_clock().now().nanoseconds * 1e-9

    def on_info(self, msg):
        self.info = msg
        self.info_received_at = self.now_s()

    def on_odom(self, m):
        now = self.now_s()
        info_age = float('inf') if self.info_received_at is None else now - self.info_received_at
        min_corr = int(self.get_parameter('min_icp_correspondences').value)
        min_ratio = float(self.get_parameter('min_icp_inlier_ratio').value)
        if self.info is None or info_age > 0.5:
            self.get_logger().warning('No fresh /odom_info; refusing to forward pose', throttle_duration_sec=2.0)
            return
        if self.info.lost or self.info.icp_correspondences < min_corr or self.info.icp_inliers_ratio < min_ratio:
            self.get_logger().warning(
                f'ICP unhealthy (lost={self.info.lost}, correspondences={self.info.icp_correspondences}, '
                f'ratio={self.info.icp_inliers_ratio:.2f}); refusing pose', throttle_duration_sec=2.0)
            return
        age_limit = float(self.get_parameter('max_odom_age_sec').value)
        stamp_s = float(m.header.stamp.sec) + float(m.header.stamp.nanosec) * 1e-9
        if stamp_s > 0 and self.get_clock().clock_type == rclpy.clock.ClockType.ROS_TIME and now - stamp_s > age_limit:
            self.get_logger().warning('Odometry stamp is stale; refusing pose', throttle_duration_sec=2.0)
            return
        cov = np.asarray(m.pose.covariance, dtype=float)
        if cov.size != 36 or not np.all(np.isfinite(cov)) or any(cov[i] <= 0 or cov[i] > 1.0 for i in (0, 7, 14)):
            self.get_logger().warning('Invalid/high pose covariance; refusing pose', throttle_duration_sec=2.0)
            return
        p = m.pose.pose.position
        o = m.pose.pose.orientation
        pos = np.array([p.x, p.y, p.z], dtype=float)
        quat = np.array([o.x, o.y, o.z, o.w], dtype=float)
        if not np.all(np.isfinite(pos)) or not np.all(np.isfinite(quat)) or np.linalg.norm(quat) < 1e-6:
            self.get_logger().warning('Non-finite pose or invalid quaternion; refusing pose', throttle_duration_sec=2.0)
            return
        try:
            r_enu_flu = quat_to_R(o.x, o.y, o.z, o.w)
            q_wxyz = R_to_quat_wxyz(R_NED_ENU @ r_enu_flu @ R_FLU_FRD)
        except (ValueError, FloatingPointError) as exc:
            self.get_logger().warning(f'Invalid orientation: {exc}', throttle_duration_sec=2.0)
            return
        v_flu = np.array([m.twist.twist.linear.x, m.twist.twist.linear.y, m.twist.twist.linear.z], dtype=float)
        w_flu = np.array([m.twist.twist.angular.x, m.twist.twist.angular.y, m.twist.twist.angular.z], dtype=float)
        if not np.all(np.isfinite(v_flu)) or not np.all(np.isfinite(w_flu)):
            self.get_logger().warning('Non-finite velocity; refusing pose', throttle_duration_sec=2.0)
            return
        out = VehicleOdometry()
        out.timestamp = int(self.get_clock().now().nanoseconds / 1000)
        out.timestamp_sample = int(m.header.stamp.sec * 1e6 + m.header.stamp.nanosec / 1e3)
        out.pose_frame = VehicleOdometry.POSE_FRAME_NED
        out.position = [float(v) for v in (R_NED_ENU @ pos)]
        out.q = [float(v) for v in q_wxyz]
        out.velocity_frame = VehicleOdometry.VELOCITY_FRAME_NED
        out.velocity = [float(v) for v in (R_NED_ENU @ (r_enu_flu @ v_flu))]
        if hasattr(out, 'angular_velocity'):
            out.angular_velocity = [float(v) for v in (R_FLU_FRD @ w_flu)]
        pv = [max(float(cov[7]), 1e-4), max(float(cov[0]), 1e-4), max(float(cov[14]), 1e-4)]
        out.position_variance = pv
        out.orientation_variance = [max(float(cov[21]), 1e-4), max(float(cov[28]), 1e-4), max(float(cov[35]), 1e-4)]
        out.velocity_variance = [0.05, 0.05, 0.05]
        if hasattr(out, 'quality'):
            out.quality = 100
        self.pub.publish(out)


def main(args=None):
    rclpy.init(args=args)
    node = VioToPx4()
    try:
        rclpy.spin(node)
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()
