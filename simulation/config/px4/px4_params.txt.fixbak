# Type in the PX4 shell (pxh>) of the terminal running `make px4_sitl ...`, then restart PX4.
# Lidar odometry gives x, y, yaw (planar). Height comes from the barometer.
param set EKF2_GPS_CTRL 0
param set EKF2_EV_CTRL 9        # 1 (horizontal position) + 8 (yaw)
param set EKF2_HGT_REF 0        # barometer height
param set EKF2_MAG_TYPE 5       # ignore magnetometer
param set EKF2_EV_DELAY 50
param set COM_ARM_WO_GPS 1
param set NAV_DLL_ACT 0
param save
