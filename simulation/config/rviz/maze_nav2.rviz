Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Views
  Name: Views
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Grid
    Enabled: true
    Name: Grid
    Value: true
    Alpha: 0.5
    Cell Size: 1
    Color: 160; 160; 164
    Plane: XY
    Plane Cell Count: 40
  - Class: rviz_default_plugins/TF
    Enabled: true
    Name: TF
    Value: true
    Show Names: false
  - Class: rviz_default_plugins/Map
    Enabled: true
    Name: Map (RTAB-Map occupancy grid)
    Value: true
    Alpha: 0.8
    Color Scheme: map
    Draw Behind: false
    Topic:
      Depth: 5
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /rtabmap/map
    Use Timestamp: false
  - Class: rviz_default_plugins/PointCloud2
    Enabled: true
    Name: Map cloud
    Value: true
    Alpha: 1
    Color Transformer: AxisColor
    Size (m): 0.03
    Style: Points
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /rtabmap/cloud_map
  - Class: rviz_default_plugins/LaserScan
    Enabled: true
    Name: Live scan
    Value: true
    Alpha: 1
    Color: 255; 50; 50
    Color Transformer: FlatColor
    Size (m): 0.05
    Style: Points
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /scan
  - Class: rviz_default_plugins/Odometry
    Enabled: true
    Name: Odometry (drone trail)
    Value: true
    Keep: 200
    Angle Tolerance: 0.1
    Position Tolerance: 0.1
    Shape:
      Alpha: 1
      Axes Length: 0.5
      Axes Radius: 0.05
      Color: 255; 255; 0
      Value: Arrow
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /odom
  - Class: rviz_default_plugins/Path
    Enabled: true
    Name: Global plan (Nav2 /plan)
    Value: true
    Alpha: 1
    Color: 25; 255; 0
    Line Style: Lines
    Line Width: 0.06
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /plan
  - Class: rviz_default_plugins/Path
    Enabled: true
    Name: Local plan (Nav2)
    Value: true
    Alpha: 1
    Color: 255; 0; 255
    Line Style: Lines
    Line Width: 0.06
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /local_plan
  - Class: rviz_default_plugins/Map
    Enabled: true
    Name: Global costmap
    Value: true
    Alpha: 0.3
    Color Scheme: costmap
    Draw Behind: false
    Topic:
      Depth: 5
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /global_costmap/costmap
    Use Timestamp: false
  - Class: rviz_default_plugins/Map
    Enabled: true
    Name: Local costmap
    Value: true
    Alpha: 0.5
    Color Scheme: costmap
    Draw Behind: false
    Topic:
      Depth: 5
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /local_costmap/costmap
    Use Timestamp: false
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: Frontiers / goal / entrance
    Value: true
    Namespaces: {}
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /wingman/frontiers
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Value: true
  Tools:
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/SetGoal
    Topic:
      Value: /goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 30
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 1.2
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 1.57
Window Geometry:
  Height: 900
  Width: 1400
