step 9: Start Rosbridge (Enables website to talk to ROS via WebSockets)
source /opt/ros/humble/setup.bash
source ~/ws_ros2/install/setup.bash
source ~/ws_wingman/install/setup.bash
ros2 launch rosbridge_server rosbridge_websocket_launch.xml unregister_timeout:=100.0 max_message_size:=10000000


Terminal 10: Start Web Video Server (Converts ROS image topics into MJPEG streams for HTML tags)
Bash
source /opt/ros/humble/setup.bash
ros2 run web_video_server web_video_server
