<?xml version="1.0"?>
<package format="3">
  <name>wingman_ros</name>
  <version>0.1.0</version>
  <description>Safe ROS 2 telemetry and perception bridge for WingMan.</description>
  <maintainer email="maintainers@example.invalid">WingMan maintainers</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>rtabmap_msgs</exec_depend>
  <exec_depend>px4_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
